    <style>
      :root {
        --black: #000000;
        --charcoal: #303030;
        --gold: #d7c09a;
        --muted: #cbc6bd;
        --cream: #fcfdfd;
        --white: #f8f8f8;
        table,
        th,
        td {
          border: 4px solid var(--gold);
          border-collapse: collapse;
          font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }
        table {
          width: 100%;
          border-collapse: collapse;
        }
        th,
        td {
          padding: 20px;
          text-align: center;
          background-color: var(--black);
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        color: var(--cream);
        background: black;
        font-family: "Bookman Old Style", Georgia, serif;
        cursor:
          url("wine-bottle.png") 12 24,
          auto;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      marquee img {
        display: inline-block;
        vertical-align: middle;
        margin: 24px;
      }

      marquee,
      footer {
        display: block;
        margin: 0;
        background: var(--white);
      }

      marquee {
        padding: 12px 0;
      }

      .client-heading {
        padding: 16px 0 0;
        background: var(--white);
        text-align: center;
      }

      .client-heading h3 {
        color: var(--black);
      }

      footer {
        padding: 16px;
        color: var(--black);
        text-align: center;
      }

      a {
        color: inherit;
      }

      /* ---------- MENU BUTTON ---------- */
      .menu-button {
        position: fixed;
        top: 24px;
        right: 24px;
        z-index: 10;
        display: grid;
        gap: 6px;
        width: 50px;
        padding: 14px 12px;
        border: 1px solid var(--gold);
        color: var(--gold);
        background: rgba(0, 0, 0, 0.45);
      }

      .menu-button span {
        display: block;
        width: 100%;
        height: 2px;
        background: currentColor;
      }
      .site-menu {
        position: fixed;
        top: 0;
        right: 0;
        z-index: 90;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 22px;
        width: min(100%, 380px);
        height: 100vh;
        padding: 100px 48px 48px;
        background: rgba(0, 0, 0, 0.98);
        box-shadow: -12px 0 36px rgba(255, 170, 0, 0.394);
        opacity: 0;
        visibility: hidden;
        transform: translateX(100%);
        transition:
          transform 0.3s ease,
          opacity 0.3s ease,
          visibility 0.3s ease;
      }

      .site-menu.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
      }

      .site-menu a {
        padding: 10px 0;
        border-bottom: 1px solid rgba(215, 192, 154, 0.35);
        color: var(--cream);
        font-family: "bookman old style", georgia, serif;
        font-size: 1.15rem;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-decoration: none;
      }

      .site-menu a:hover,
      .site-menu a:focus-visible {
        color: var(--gold);
        outline: none;
      }

      @media (max-width: 760px) {
        .site-menu {
          width: min(100%, 320px);
          padding: 88px 32px 32px;
        }
      }
      /* ---------- HERO ---------- */

      .hero {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 72px 20px;
        text-align: center;
        background: var(--black);
      }

      .hero-inner {
        width: min(100%, 950px);
        margin: 0 auto;
      }

      .logo {
        display: block;
        width: min(100%, 487px);
        height: auto;
        margin: 0 auto 32px;
      }
      .eyebrow {
        margin: 0 0 14px;
        color: var(--gold);
        font-family: "bookman old style", georgia, serif;
        font-size: 1rem;
        font-weight: 0;
        letter-spacing: 0.2em;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-weight: 400;
        line-height: 1.15;
        color: #ffffff;
      }

      h1 {
        max-width: 930px;
        margin: 0 auto 28px;
        font-size: clamp(1.25rem, 3.5vw, 3rem);
        font-family: "bookman old style", georgia, serif;
      }

      h2 {
        font-size: clamp(2rem, 4vw, 3.35rem);
      }

      h3 {
        font-size: clamp(1.8rem, 3.5vw, 3rem);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: var(--white);
        color: var(--black);
      }

      p {
        line-height: 1.7;
      }

      .hero-copy {
        max-width: 760px;
        margin: 0 auto 30px;
        color: var(--cream);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        font-size: clamp(1rem, 2vw, 1.2rem);
      }

      /* ---------- BUTTONS ---------- */

      .btn {
        display: inline-block;
        padding: 14px 24px;
        border: 1px solid var(--gold);
        color: var(--black);
        background: var(--gold);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
        transition:
          background 0.2s ease,
          color 0.2s ease;
      }

      .btn:hover,
      .btn:focus-visible {
        color: var(--cream);
        background: transparent;
      }

      .btn.outline {
        color: var(--cream);
        background: transparent;
      }

      .btn.outline:hover,
      .btn.outline:focus-visible {
        color: var(--cream);
        background: var(--gold);
      }

      /* ---------- ALTERNATING SECTIONS ---------- */

      .split-section {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        min-height: 560px;
        background: var(--black);
      }

      .section-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: clamp(50px, 8vw, 120px);
      }

      .section-copy p:not(.eyebrow) {
        max-width: 620px;
        margin: 22px 0 0;
        color: var(--muted);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        font-size: clamp(1rem, 1.6vw, 1.18rem);
      }

      .split-section.light .section-copy p:not(.eyebrow) {
        color: #ffffff;
      }

      .info-panel {
        padding: clamp(60px, 8vw, 110px) 20px;
        background: var(--black);
      }

      .info-panel-inner {
        width: min(100%, 980px);
        margin: 0 auto;
      }

      .info-panel .eyebrow {
        margin: 0 0 20px;
      }

      .info-panel h2,
      .info-panel h3 {
        margin: 0 0 16px;
      }

      .info-panel p:not(.eyebrow) {
        margin: 0 0 24px;
        color: var(--muted);
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        font-size: clamp(1rem, 1.6vw, 1.18rem);
        line-height: 1.7;
      }

      .section-copy .btn {
        align-self: flex-start;
        margin-top: 30px;
      }

      .section-image {
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        min-height: 560px;
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
      }

      .section-image img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      /*
      alternating text sides on desktop, but not on mobile
    */
      .split-section.reversed .section-copy {
        order: 2;
      }

      .split-section.reversed .section-image {
        order: 1;
      }
      /* ---------- MOBILE ---------- */

      @media (max-width: 760px) {
        .hero {
          min-height: auto;
          padding: 80px 20px;
        }

        .split-section {
          grid-template-columns: 1fr;
          min-height: auto;
        }

        .section-copy {
          min-height: auto;
          padding: 56px 24px;
        }

        .section-image {
          min-height: 280px;
        }

        .section-copy .btn {
          width: 100%;
          text-align: center;
        }

        .info-panel {
          padding: 56px 20px;
        }

        /*
        On mobile, show copy first and image second
        even for sections that alternate on desktop.
      */
        .split-section.reversed .section-copy,
        .split-section.reversed .section-image {
          order: initial;
        }
      }
    </style>
